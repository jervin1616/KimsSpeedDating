{
  // Free plan only: one Worker, one SQLite-backed Durable Object, static assets.
  "name": "kims-speed-dating",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker. The page itself is served as free static assets.
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "DB", "class_name": "Database" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Database"] }],

  // Public, non-secret settings. The secrets (ROLES, SESSION_SECRET, ADMIN_KEY) are set with
  // "npx wrangler secret put <NAME>" and are never stored in this repo. See DEPLOY.md.
  "vars": {
    // Your Google OAuth client ID (it is public). Fill in at step 6 of DEPLOY.md.
    "GOOGLE_CLIENT_ID": "429244706676-rqnm8ofktcdk1l8cc1rop7e7qbtvtln5.apps.googleusercontent.com",
    // Role for signed-in emails that are not on the ROLES list: none, viewer or contributor.
    "DEFAULT_ROLE": "viewer",
    // How long a login lasts before the page quietly renews it (hours).
    "SESSION_HOURS": "12",
    // Extra allowed origins for WebSockets, comma separated. The Worker's own address is always allowed.
    "ALLOWED_ORIGINS": ""
  },

  "observability": { "enabled": false }
}
